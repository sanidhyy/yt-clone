{
	"name": "yt-clone",
	"version": "1.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently \"pnpm run dev:next\" \"pnpm run dev:webhook\"",
		"dev:next": "next dev --webpack",
		"dev:webhook": "ngrok http 3000",
		"build": "next build --webpack",
		"start": "next start --webpack",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed:categories": "tsx ./src/scripts/seed-categories.ts",
		"postinstall": "drizzle-kit generate"
	},
	"dependencies": {
